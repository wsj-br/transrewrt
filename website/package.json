{
  "name": "transrewrt-website",
  "private": true,
  "version": "1.6.3",
  "type": "module",
  "scripts": {
    "dev": "node --env-file=./telemetry.env ./node_modules/astro/bin/astro.mjs dev",
    "prebuild": "pnpm install --frozen-lockfile",
    "build": "node --env-file=./telemetry.env ./node_modules/astro/bin/astro.mjs build",
    "preview": "node --env-file=./telemetry.env ./node_modules/astro/bin/astro.mjs preview",
    "astro": "node --env-file=./telemetry.env ./node_modules/astro/bin/astro.mjs",
    "i18n:sync": "ai-i18n-tools sync",
    "i18n:status": "ai-i18n-tools status",
    "publish:pages": "node scripts/publish-pages.mjs",
    "publish:pages:dry": "node scripts/publish-pages.mjs --dry-run"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.25.0",
  "dependencies": {
    "@astrojs/react": "^6.0.5",
    "@astrojs/starlight": "^0.42.0",
    "@astrojs/starlight-tailwind": "^5.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.1",
    "lucide-react": "^1.41.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "ai-i18n-tools": "^1.8.4",
    "typescript": "^7.0.2"
  }
}
