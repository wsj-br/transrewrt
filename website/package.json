{
  "name": "transrewrt-website",
  "private": true,
  "version": "1.7.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file=./telemetry.env ./node_modules/astro/bin/astro.mjs dev",
    "prebuild": "pnpm install --frozen-lockfile",
    "build": "node --env-file=./telemetry.env ./node_modules/astro/bin/astro.mjs build",
    "preview": "node --env-file=./telemetry.env ./node_modules/astro/bin/astro.mjs preview",
    "astro": "node --env-file=./telemetry.env ./node_modules/astro/bin/astro.mjs",
    "i18n:sync": "cd .. && ai-i18n-tools sync",
    "i18n:status": "cd .. && ai-i18n-tools status",
    "i18n:translate": "cd .. && ai-i18n-tools sync",
    "i18n:translate:ui": "cd .. && ai-i18n-tools translate-ui",
    "i18n:locales": "cd .. && ai-i18n-tools generate-ui-languages",
    "publish:pages": "node scripts/publish-pages.mjs",
    "publish:pages:dry": "node scripts/publish-pages.mjs --dry-run"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.25.0",
  "dependencies": {
    "@astrojs/react": "^6.0.6",
    "@astrojs/starlight": "^0.42.10",
    "@astrojs/starlight-tailwind": "^5.0.0",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.7",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "ai-i18n-tools": "^1.13.2",
    "typescript": "^7.0.2"
  }
}
