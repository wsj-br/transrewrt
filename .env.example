# OpenRouter API key (required for web server if not set in config.json).
# Get one at https://openrouter.ai
export API_KEY=your-openrouter-api-key

# Optional: override upstream AI API base URL (default: https://openrouter.ai/api/v1)
# export API_URL=https://openrouter.ai/api/v1

# Optional: key seed for Transrewrt proxy (shared secret with the proxy; also configurable in Settings → API)
# export KEY_SEED=your-shared-key-seed

# Optional: server port (default: 5000)
# export PORT=5000

# Optional: path to config file (default: data/config.json when running from repo root)
# export CONFIG_PATH=/path/to/config.json
