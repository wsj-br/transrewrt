# LLM keys for the web server (optional if stored in config).
# Get an OpenRouter key at https://openrouter.ai
export OPENROUTER_API_KEY=your-openrouter-api-key

# Optional: other providers (see README / docker-compose)
# export OPENAI_API_KEY=...
# export CEREBRAS_API_KEY=...
# export ANTHROPIC_API_KEY=...
# export GOOGLE_API_KEY=...
# export DEEPSEEK_API_KEY=...
# export GROQ_API_KEY=...   
# export MISTRAL_API_KEY=...
# export XAI_API_KEY=...
# export OLLAMA_URL=...

# Optional: custom OpenAI-compatible provider (all three required), e.g. NVIDIA NIM
# Get a free API key at https://build.nvidia.com/
# export CUSTOM_PROVIDER_NAME=NVIDIA
# export CUSTOM_PROVIDER_URL=https://integrate.api.nvidia.com/v1
# export CUSTOM_PROVIDER_API_KEY=nvapi-...

# Optional: OpenRouter API base URL (default: https://openrouter.ai/api/v1)
# export OPENROUTER_API_URL=https://openrouter.ai/api/v1

# Optional: server port (default: 5000)
# export PORT=5000

# Optional: path to config file (default: data/config.json when running from repo root)
# export CONFIG_PATH=/path/to/config.json

# Optional: disable execution history for all users (server and/or Electron main); see README → Configuration and environment
# export HISTORY_DISABLED=1
