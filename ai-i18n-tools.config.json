{
  "sourceLocale": "en-GB",
  "targetLocales": [    "ar",    "zh-Hans",    "zh-Hant",    "cs",    "nl",    "fr",    "de",      "el",
                        "hi",    "hu",    "it",    "ja",    "ko",    "fa",    "pl",    "pt-BR",    "ro",
                        "ru",    "sk",    "es",    "sv",    "th",    "tr",    "uk",    "vi"  
                   ],
  "concurrency": 8,
  "batchSize": 20,
  "maxBatchChars": 4096,
  "features": {
    "translateUIStrings": true,
    "translateDocs": true,
    "translateJson": true
  },
  "providers": {
    "openrouter": {
      "translationModels": [
        "google/gemini-3.1-flash-lite-preview",
        "google/gemini-2.5-flash",
        "google/gemini-2.5-pro",
        "anthropic/claude-sonnet-4.6",
        "openai/gpt-5.4",
        "google/gemma-4-31b-it",
        "openai/gpt-5.1",
        "deepseek/deepseek-v4-flash",
        "deepseek/deepseek-v3.2-exp",
        "google/gemma-3-27b-it"
      ]
    }
  },
  "provider": "openrouter",
  "ui": [
    {
      "description": "App (renderer)",
      "sourceRoots": [
        "src/renderer/"
      ],
      "stringsJson": "src/renderer/locales/strings.json",
      "flatOutputDir": "src/renderer/locales/",
      "reactExtractor": {
        "includeUiLanguageEnglishNames": true
      }
    },
    {
      "description": "Website (marketing)",
      "sourceRoots": [
        "website/src/components/marketing/"
      ],
      "stringsJson": "website/src/i18n/strings.json",
      "flatOutputDir": "website/src/i18n/locales/",
      "languagesManifestPath": "website/src/i18n/ui-languages.json",
      "uiGlossary": false
    }
  ],
  "glossary": {
    "userGlossary": "glossary-user.csv"
  },
  "docs": [
    {
      "description": "README",
      "contentPaths": [
        "README.md"
      ],
      "outputDir": "translated-docs/",
      "addFrontmatter": false,
      "docsOutput": {
        "style": "flat",
        "postProcessing": {
          "regexAdjustments": [
            {
              "description": "Per-locale screenshot folders in the GitHub Pages image URL",
              "search": "images/screenshots/[^/]+/",
              "replace": "images/screenshots/${translatedLocale}/"
            }
          ],
          "languageListBlock": {
            "start": "<small id=\"lang-list\">",
            "end": "</small>",
            "separator": " · "
          }
        }
      }
    },
    {
      "description": "Website Starlight onboarding",
      "contentPaths": [
        "website/src/content/docs/docs/*.md"
      ],
      "outputDir": "website/src/content/docs/",
      "addFrontmatter": false,
      "docsOutput": {
        "style": "astro-starlight",
        "docsRoot": "website/src/content/docs",
        "localePathLowercase": true,
        "postProcessing": {
          "regexAdjustments": [
            {
              "description": "Per-locale screenshot folders under public/",
              "search": "images/screenshots/[^/]+/",
              "replace": "images/screenshots/${translatedLocale}/"
            }
          ]
        }
      }
    }
  ],
  "json": [
    {
      "description": "Starlight docs sidebar group headings",
      "contentPaths": [
        "website/src/i18n/docs-sidebar-groups.json"
      ],
      "outputPathTemplate": "website/src/i18n/docs-sidebar-groups/{locale}.json"
    }
  ]
}
