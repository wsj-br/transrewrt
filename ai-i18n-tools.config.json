{
  "sourceLocale": "en-GB",
  "targetLocales": [
    "pt-BR",    "ar",    "bn",    "ca",    "zh-CN",    "zh-TW",    "hr",    "cs",    "nl",    "en-US",    
    "tl",       "fr",    "de",    "el",    "hi",    "hu",    "it",    "ja",    "ko",    "ms",    "fa",
    "pl",       "jv",    "pt",    "pa",    "ro",    "ru",    "sk",    "es",    "sw",    "sv",    "te",
    "th",       "tr",    "uk",    "vi"
  ],
  "concurrency": 4,
  "batchSize": 20,
  "maxBatchChars": 4096,
  "openrouter": {
    "translationModels": [
      "qwen/qwen3-235b-a22b-2507",
      "openai/gpt-4o-mini",
      "deepseek/deepseek-v4-flash",
      "anthropic/claude-3-haiku",
      "qwen/qwen3.6-plus",
      "anthropic/claude-3.5-haiku",
      "google/gemini-3-flash-preview",
      "~anthropic/claude-haiku-latest",
      "google/gemma-4-31b-it",
      "~anthropic/claude-sonnet-latest",
      "openai/gpt-5.3-codex"
    ]
  },
  "features": {
    "translateUIStrings": true,
    "translateDocs": true
  },
  "ui": {
    "sourceRoots": [
      "src/renderer/"
    ],
    "stringsJson": "src/renderer/locales/strings.json",
    "flatOutputDir": "src/renderer/locales/",
    "reactExtractor": {
      "includeUiLanguageEnglishNames": true
    }
  },
  "glossary": {
    "uiGlossary": "src/renderer/locales/strings.json",
    "userGlossary": "glossary-user.csv"
  },
  "docs": [
    {
      "description": "README and User Guide",
      "contentPaths": [
        "README.md",
        "USER-GUIDE.md"
      ],
      "outputDir": "translated-docs/",
      "docsOutput": {
        "style": "flat",
        "postProcessing": {
          "regexAdjustments": [
            {
              "description": "Per-locale screenshot folders",
              "search": "images/screenshots/[^/]+/",
              "replace": "images/screenshots/${translatedLocale}/"
            }
          ],
          "languageListBlock": {
            "start": "<small id=\"lang-list\">",
            "end": "</small>",
            "separator": " · "
          }
        }
      }
    }
  ]
}
