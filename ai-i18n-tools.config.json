{
  "sourceLocale": "en-GB",
  "targetLocales": [
    "pt-BR" , "ar" , "bn" , "ca" , "zh-Hans" , "zh-Hant" , "hr" , "cs" , "nl" , "en-US" , "tl" , 
    "fr" , "de" , "el" , "hi-Latn" , "hu" , "it" , "ja" , "ko" , "ms" , "fa" , "pl" , "jv" , "pt" , 
    "pa-PK" , "ro" , "ru" , "sk" , "es" , "sw" , "sv" , "te" , "th" , "tr" , "uk" , "vi"
  ],
  "concurrency": 8,
  "batchSize": 20,
  "maxBatchChars": 4096,
  "features": {
    "translateUIStrings": true,
    "translateDocs": true
  },
  "ui": {
    "sourceRoots": [
      "src/renderer/"
    ],
    "stringsJson": "src/renderer/locales/strings.json",
    "flatOutputDir": "src/renderer/locales/",
    "reactExtractor": {
      "includeUiLanguageEnglishNames": true
    }
  },
  "glossary": {
    "uiGlossary": "src/renderer/locales/strings.json",
    "userGlossary": "glossary-user.csv"
  },
  "docs": [
    {
      "description": "README and User Guide",
      "contentPaths": [
        "README.md",
        "USER-GUIDE.md"
      ],
      "outputDir": "translated-docs/",
      "addFrontmatter": false,
      "docsOutput": {
        "style": "flat",
        "postProcessing": {
          "regexAdjustments": [
            {
              "description": "Per-locale screenshot folders",
              "search": "images/screenshots/[^/]+/",
              "replace": "images/screenshots/${translatedLocale}/"
            }
          ],
          "languageListBlock": {
            "start": "<small id=\"lang-list\">",
            "end": "</small>",
            "separator": " · "
          }
        }
      }
    }
  ],
  "providers": {
    "openrouter": {
      "translationModels": [
        "google/gemini-2.5-flash",
        "meta-llama/llama-3.3-70b-instruct",
        "openai/gpt-4o-mini",
        "google/gemma-4-26b-a4b-it",
        "~anthropic/claude-haiku-latest",
        "z-ai/glm-5.2",
        "google/gemini-3.5-flash",
        "~anthropic/claude-sonnet-latest"
      ],
      "uiModels": [
        "~anthropic/claude-sonnet-latest",
        "z-ai/glm-5.2"
      ],
      "localeModels": [
        { "locale": "ja",      "models": [ "z-ai/glm-5.2", "minimax/minimax-m2.7" ] },
        { "locale": "ko",      "models": [ "z-ai/glm-5.2", "minimax/minimax-m2.7" ] },
        { "locale": "zh-Hans", "models": [ "z-ai/glm-5.2", "minimax/minimax-m2.7" ] },
        { "locale": "zh-Hant", "models": [ "z-ai/glm-5.2", "minimax/minimax-m2.7" ] }
      ]
    }
  },
  "provider": "openrouter"
}
