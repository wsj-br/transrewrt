{
  "name": "translator-and-rewriter",
  "version": "1.0.0",
  "description": "Translator & Rewriter Application",
  "main": "src/main/main.js",
  "scripts": {
    "dev": "concurrently \"npm run watch\" \"npm run electron\"",
    "watch": "webpack serve --mode development --port 3000",
    "electron": "wait-on http://localhost:3000 && cross-env NODE_ENV=development electron .",
    "build-renderer": "node node_modules/webpack/bin/webpack.js --mode production",
    "package": "npm run build-renderer && electron-builder",
    "start": "electron .",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "electron",
    "react",
    "translator",
    "rewriter"
  ],
  "author": "T&R Team",
  "license": "MIT",
  "build": {
    "appId": "com.yourcompany.translator-and-rewriter",
    "productName": "Translator & Rewriter",
    "files": [
      "dist/**/*",
      "src/main/main.js",
      "package.json"
    ],
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "win": {
      "target": "nsis"
    }
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/preset-react": "^7.18.0",
    "babel-loader": "^8.3.0",
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0",
    "css-loader": "^6.7.0",
    "electron": "^40.0.0-beta.2",
    "electron-builder": "^26.0.12",
    "html-webpack-plugin": "^5.5.0",
    "mini-css-extract-plugin": "^2.9.4",
    "style-loader": "^3.3.0",
    "wait-on": "^7.2.0",
    "webpack": "^5.103.0",
    "webpack-cli": "^4.10.0"
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "webpack-dev-server": "^4.15.2"
  }
}
