{
  "name": "t-r",
  "version": "1.0.0",
  "description": "Translator & Rewriter Application",
  "main": "src/main/main.js",
  "scripts": {
    "dev": "concurrently \"npm run watch\" \"npm run electron\"",
    "watch": "webpack serve --mode development --port 3030",
    "electron": "wait-on http://localhost:3030 && cross-env NODE_ENV=development electron . --disable-gpu-compositing --enable-unsafe-webgpu --ozone-platform=x11",
    "build-renderer": "node node_modules/webpack/bin/webpack.js --mode production",
    "package": "npm run build-renderer && node scripts/build-with-timestamp.js",
    "start": "electron .",
    "start-x11": "electron . --disable-gpu-compositing --enable-unsafe-webgpu --ozone-platform=x11",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "electron",
    "react",
    "translator",
    "rewriter"
  ],
  "author": "Waldemar Scudeller Jr.",
  "license": "MIT",
  "build": {
    "appId": "br.com.wsj.t-r",
    "productName": "Translator & Rewriter",
    "files": [
      "dist/**/*",
      "src/main/main.js",
      "package.json"
    ],
    "extraFiles": [
      {
        "from": "config_default.json",
        "to": "config_default.json"
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "."
    },
    "win": {
      "target": "nsis",
      "forceCodeSigning": false,
      "icon": "tr_logo.ico",
      "artifactName": "${productName} Setup ${version}-${env.BUILD_TIMESTAMP}.${ext}"
    },
    "nsis": {
      "installerIcon": "tr_logo.ico",
      "uninstallerIcon": "tr_logo.ico",
      "installerHeaderIcon": "tr_logo.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Translator & Rewriter"
    }
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-react": "^7.28.5",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.6.2",
    "babel-loader": "^10.0.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "css-loader": "^7.1.3",
    "electron": "^40.2.1",
    "electron-builder": "^26.7.0",
    "electron-reload": "^2.0.0-alpha.1",
    "html-webpack-plugin": "^5.6.6",
    "mini-css-extract-plugin": "^2.10.0",
    "react-refresh": "^0.18.0",
    "style-loader": "^4.0.0",
    "wait-on": "^9.0.3",
    "webpack": "^5.105.0",
    "webpack-cli": "^6.0.1"
  },
  "overrides": {
    "rimraf": "^5.0.0",
    "glob": "^13.0.0",
    "global-agent": "^4.1.2"
  },
  "dependencies": {
    "@ctrl/tinycolor": "^4.2.0",
    "@fluentui/react-components": "^9.72.11",
    "@fluentui/react-icons": "^2.0.318",
    "electron-squirrel-startup": "^1.0.1",
    "lucide-react": "^0.563.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "webpack-dev-server": "^5.2.3"
  }
}
