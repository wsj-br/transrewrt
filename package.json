{
  "name": "transrewrt",
  "version": "1.3.1",
  "description": "Translate text between languages, rewrite text in different styles, and transform text using AI.",
  "main": "src/main/main.js",
  "scripts": {
    "dev": "node scripts/electron-rebuild.js && node scripts/write-build-timestamp.js && concurrently \"pnpm run watch\" \"pnpm run electron\"",
    "dev:web": "node scripts/node-rebuild.js && node scripts/write-build-timestamp.js && concurrently \"pnpm run watch:web\" \"cross-env DEV_WEB=true PORT=3030 pnpm run start:server\"",
    "watch": "webpack serve --mode development --port 3030",
    "watch:web": "webpack serve --mode development --port 5000",
    "electron": "wait-on http://localhost:3030 && cross-env NODE_ENV=development electron . ",
    "build": "node node_modules/webpack/bin/webpack.js --mode production",
    "build-renderer": "node node_modules/webpack/bin/webpack.js --mode production",
    "start": "electron .",
    "start-x11": "electron . --disable-gpu-compositing --enable-unsafe-webgpu --ozone-platform=x11",
    "start:server": "node scripts/check-node-version.js",
    "start:server:rebuild": "pnpm run postinstall && pnpm run start:server",
    "serve": "pnpm run build-renderer && pnpm run start:server",
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:clean": "./scripts/clean-docker.sh",
    "docker:devel": "docker build . -t wsj-br/transrewrt:devel",
    "docker:logs": "docker logs transrewrt",
    "docker:shell": "docker exec -it transrewrt /bin/sh",
    "build:main": "node node_modules/webpack/bin/webpack.js --config webpack.main.config.js",
    "package": "pnpm run build && pnpm run build:main && node scripts/write-build-timestamp.js && electron-builder",
    "package-arm64": "pnpm run build && pnpm run build:main && node scripts/write-build-timestamp.js && pnpm exec electron-builder --linux AppImage --arm64 --publish never --config build/electron-builder.linux-arm64.cjs",
    "generate-test-data": "node scripts/generate-test-data.js",
    "i18n:extract": "ai-i18n-tools extract",
    "i18n:sync": "ai-i18n-tools sync",
    "i18n:translate": "ai-i18n-tools translate-ui && ai-i18n-tools translate-svg && ai-i18n-tools translate-docs",
    "i18n:translate:ui": "ai-i18n-tools translate-ui",
    "i18n:translate:svg": "ai-i18n-tools translate-svg",
    "i18n:translate:docs": "ai-i18n-tools translate-docs",
    "i18n:status": "ai-i18n-tools status",
    "i18n:editor": "ai-i18n-tools editor",
    "i18n:cleanup": "ai-i18n-tools cleanup",
    "clean-temp": "find . \\( -name '*.log' -o -name 'cache.db.backup*.sqlite' \\) -print && read -p '\nDelete these files? (y/n) ' ans && [ \"$ans\" = \"y\" ] && find . \\( -name '*.log' -o -name 'cache.db.backup*.sqlite' \\) -delete",
    "update-version": "node scripts/update-version.js",
    "postinstall": "node scripts/electron-rebuild.js",
    "reset-web-password": "node scripts/reset-web-password.js",
    "take-screenshots": "node scripts/take-screenshots.js",
    "generate-banner": "node scripts/generate-transrewrt-banner.js",
    "check-api-key": "node scripts/check-api-key.js",
    "3p-notices": "node scripts/write-third-party-notices.js"
  },
  "keywords": [
    "electron",
    "react",
    "translator",
    "rewriter"
  ],
  "author": "Waldemar Scudeller Jr.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "build": {
    "appId": "br.com.wsj.transrewrt",
    "productName": "Transrewrt",
    "extraMetadata": {
      "main": "dist-main/main.js"
    },
    "files": [
      "dist/**/*",
      "dist-main/**/*",
      "images/**/*",
      "package.json",
      "build_timestamp",
      "!.git/**",
      "!**/tests/**",
      "!**/test/**",
      "!**/docs/**"
    ],
    "asar": {
      "smartUnpack": true
    },
    "extraFiles": [
      {
        "from": "src/config-defaults/config_default.json",
        "to": "config/config_default.json"
      },
      {
        "from": "NOTICES",
        "to": "NOTICES"
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "images"
    },
    "publish": null,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "forceCodeSigning": false,
      "icon": "transrewrt_logo.ico",
      "artifactName": "${productName} Setup ${version}.${ext}"
    },
    "linux": {
      "icon": "transrewrt_logo_512x512.png",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "include": "build/installer.nsh",
      "oneClick": false,
      "installerSidebar": "installerSidebar.bmp",
      "uninstallerSidebar": "installerSidebar.bmp",
      "installerIcon": "transrewrt_logo.ico",
      "uninstallerIcon": "transrewrt_logo.ico",
      "installerHeaderIcon": "transrewrt_logo.ico",
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "Transrewrt"
    }
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@electron/rebuild": "^4.0.4",
    "@eslint/js": "^9.39.4",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.6.2",
    "@tailwindcss/postcss": "^4.2.4",
    "tailwindcss": "^4.2.4",
    "@types/papaparse": "^5.5.2",
    "babel-loader": "^10.1.1",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "concurrently": "^9.2.1",
    "copy-webpack-plugin": "^14.0.0",
    "cross-env": "^10.1.0",
    "css-loader": "^7.1.4",
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1",
    "electron-reload": "2.0.0-alpha.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "events": "^3.3.0",
    "glob": "^13.0.6",
    "globals": "^17.5.0",
    "gray-matter": "^4.0.3",
    "html-webpack-plugin": "^5.6.7",
    "license-checker-rseidelsohn": "^4.4.2",
    "mini-css-extract-plugin": "^2.10.2",
    "papaparse": "^5.5.3",
    "postcss-loader": "^8.2.1",
    "prop-types": "^15.8.1",
    "puppeteer": "^24.42.0",
    "react-refresh": "^0.18.0",
    "sharp": "^0.34.5",
    "sql.js": "^1.14.1",
    "style-loader": "^4.0.0",
    "tw-animate-css": "^1.4.0",
    "wait-on": "^9.0.5",
    "webpack": "^5.106.2",
    "webpack-cli": "^7.0.2"
  },
  "pnpm": {
    "allowedDeprecatedVersions": {
      "prebuild-install": "7.1.3"
    },
    "overrides": {
      "yauzl": ">=3.2.1",
      "rimraf": "^5.0.0",
      "glob": "^13.0.0",
      "global-agent": "^4.1.2",
      "qs": ">=6.14.2",
      "minimatch": ">=10.2.1",
      "lodash": ">=4.18.0",
      "@xmldom/xmldom": ">=0.8.13",
      "uuid": ">=14.0.0",
      "postcss": ">=8.5.10"
    },
    "onlyBuiltDependencies": [
      "argon2",
      "better-sqlite3",
      "core-js-pure",
      "electron",
      "electron-winstaller",
      "esbuild",
      "protobufjs",
      "puppeteer",
      "sharp"
    ]
  },
  "dependencies": {
    "@ctrl/tinycolor": "^4.2.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "adm-zip": "^0.5.17",
    "ai-i18n-tools": "^1.2.3",
    "archiver": "^7.0.1",
    "argon2": "^0.44.0",
    "better-sqlite3": "^12.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "diff": "^9.0.0",
    "express": "^5.2.1",
    "geist": "^1.7.0",
    "i18next": "^26.0.8",
    "lucide-react": "^1.11.0",
    "multer": "^2.1.1",
    "multi-llm-ts": "5.1.0-beta4",
    "proper-lockfile": "^4.1.2",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-i18next": "^17.0.6",
    "recharts": "^3.8.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "vaul": "^1.1.2",
    "webpack-dev-server": "^5.2.3",
    "xlsx-js-style": "^1.2.0"
  }
}
