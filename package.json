{
  "name": "translator-and-rewriter",
  "version": "1.0.0",
  "description": "Translator & Rewriter Application",
  "main": "src/main/main.js",
  "scripts": {
    "dev": "concurrently \"npm run watch\" \"npm run electron\"",
    "watch": "webpack serve --mode development --port 3030",
    "electron": "wait-on http://localhost:3030 && cross-env NODE_ENV=development electron .",
    "build-renderer": "node node_modules/webpack/bin/webpack.js --mode production",
    "package": "npm run build-renderer && node scripts/build-with-timestamp.js",
    "start": "electron .",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "electron",
    "react",
    "translator",
    "rewriter"
  ],
  "author": "Waldemar Scudeller Jr.",
  "license": "MIT",
  "build": {
    "appId": "br.com.wsj.translator-and-rewriter",
    "productName": "Translator & Rewriter",
    "files": [
      "dist/**/*",
      "src/main/main.js",
      "package.json"
    ],
    "extraFiles": [
      {
        "from": "config_default.json",
        "to": "config_default.json"
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "."
    },
    "win": {
      "target": "nsis",
      "forceCodeSigning": false,
      "icon": "tr_logo.ico",
      "artifactName": "${productName} Setup ${version}-${env.BUILD_TIMESTAMP}.${ext}"
    },
    "nsis": {
      "installerIcon": "tr_logo.ico",
      "uninstallerIcon": "tr_logo.ico",
      "installerHeaderIcon": "tr_logo.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Translator & Rewriter"
    }
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/preset-react": "^7.18.0",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.6.2",
    "babel-loader": "^8.3.0",
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0",
    "css-loader": "^6.7.0",
    "electron": "^40.0.0-beta.2",
    "electron-builder": "^26.6.0",
    "electron-reload": "^2.0.0-alpha.1",
    "html-webpack-plugin": "^5.5.0",
    "mini-css-extract-plugin": "^2.9.4",
    "react-refresh": "^0.18.0",
    "style-loader": "^3.3.0",
    "wait-on": "^7.2.0",
    "webpack": "^5.103.0",
    "webpack-cli": "^4.10.0"
  },
  "dependencies": {
    "@ctrl/tinycolor": "^4.2.0",
    "@fluentui/react-components": "^9.72.8",
    "@fluentui/react-icons": "^2.0.316",
    "electron-squirrel-startup": "^1.0.1",
    "lucide-react": "^0.556.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "webpack-dev-server": "^4.15.2"
  }
}
