{
  "name": "transrewrt",
  "version": "1.0.9",
  "description": "Translate text between languages, rewrite text in different styles, and transform text using AI.",
  "main": "src/main/main.js",
  "scripts": {
    "dev": "node scripts/electron-rebuild.js && node scripts/write-build-timestamp.js && concurrently \"pnpm run watch\" \"pnpm run electron\"",
    "dev:web": "node scripts/node-rebuild.js && node scripts/write-build-timestamp.js && concurrently \"pnpm run watch:web\" \"cross-env DEV_WEB=true PORT=3030 pnpm run start:server\"",
    "watch": "webpack serve --mode development --port 3030",
    "watch:web": "webpack serve --mode development --port 5000",
    "electron": "wait-on http://localhost:3030 && cross-env NODE_ENV=development electron . ",
    "build": "node node_modules/webpack/bin/webpack.js --mode production",
    "build-renderer": "node node_modules/webpack/bin/webpack.js --mode production",
    "start": "electron .",
    "start-x11": "electron . --disable-gpu-compositing --enable-unsafe-webgpu --ozone-platform=x11",
    "start:server": "node scripts/check-node-version.js",
    "start:server:rebuild": "pnpm run postinstall && pnpm run start:server",
    "serve": "pnpm run build-renderer && pnpm run start:server",
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:clean": "./scripts/clean-docker.sh",
    "docker:devel": "docker build . -t wsj-br/transrewrt:devel",
    "docker:logs": "docker logs transrewrt-web-1",
    "docker:shell": "docker exec -it transrewrt-web-1 /bin/sh",
    "package": "pnpm run build && node scripts/write-build-timestamp.js && electron-builder",
    "generate-test-data": "node scripts/generate-test-data.js",
    "i18n:extract": "node scripts/extract-strings.js",
    "i18n:translate": "node scripts/generate-translations.js",
    "i18n:sync": "pnpm run i18n:extract && pnpm run i18n:translate",
    "update-version": "node scripts/update-version.js",
    "postinstall": "node scripts/electron-rebuild.js",
    "reset-web-password": "node scripts/reset-web-password.js"
  },
  "keywords": [
    "electron",
    "react",
    "translator",
    "rewriter"
  ],
  "author": "Waldemar Scudeller Jr.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "build": {
    "appId": "br.com.wsj.transrewrt",
    "productName": "Transrewrt",
    "files": [
      "dist/**/*",
      "src/main/**/*",
      "images/**/*",
      "package.json",
      "build_timestamp",
      "!.git/**",
      "!**/tests/**",
      "!**/test/**",
      "!**/docs/**"
    ],
    "asar": {
      "smartUnpack": true
    },
    "extraFiles": [
      {
        "from": "src/config-defaults/config_default.json",
        "to": "config/config_default.json"
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "images"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "forceCodeSigning": false,
      "icon": "transrewrt_logo.ico",
      "artifactName": "${productName} Setup ${version}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}.${ext}"
    },
    "nsis": {
      "include": "build/installer.nsh",
      "installerIcon": "transrewrt_logo.ico",
      "uninstallerIcon": "transrewrt_logo.ico",
      "installerHeaderIcon": "transrewrt_logo.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Transrewrt"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "eslint": "^9.15.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.4.0",
    "@babel/core": "^7.29.0",
    "@babel/preset-react": "^7.28.5",
    "@electron/rebuild": "^4.0.3",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.6.2",
    "babel-loader": "^10.1.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "css-loader": "^7.1.4",
    "electron": "^40.8.0",
    "electron-builder": "^26.8.1",
    "electron-reload": "2.0.0-alpha.1",
    "events": "^3.3.0",
    "html-webpack-plugin": "^5.6.6",
    "mini-css-extract-plugin": "^2.10.1",
    "prop-types": "^15.8.1",
    "react-refresh": "^0.18.0",
    "sql.js": "^1.14.1",
    "style-loader": "^4.0.0",
    "wait-on": "^9.0.4",
    "webpack": "^5.105.4",
    "webpack-cli": "^6.0.1"
  },
  "pnpm": {
    "allowedDeprecatedVersions": {
      "prebuild-install": "7.1.3"
    },
    "overrides": {
      "lodash-es": "^4.17.23",
      "rimraf": "^5.0.0",
      "glob": "^13.0.0",
      "global-agent": "^4.1.2",
      "qs": ">=6.14.2",
      "minimatch": ">=10.2.1",
      "serialize-javascript": ">=7.0.3"
    },
    "onlyBuiltDependencies": [
      "core-js-pure",
      "electron",
      "electron-winstaller",
      "better-sqlite3",
      "argon2"
    ]
  },
  "dependencies": {
    "@ctrl/tinycolor": "^4.2.0",
    "@fluentui/react-components": "^9.73.2",
    "@fluentui/react-icons": "^2.0.320",
    "argon2": "^0.44.0",
    "better-sqlite3": "^12.6.2",
    "express": "^5.2.1",
    "i18next": "^25.8.17",
    "lucide-react": "^0.577.0",
    "proper-lockfile": "^4.1.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-i18next": "^16.5.6",
    "recharts": "^3.8.0",
    "webpack-dev-server": "^5.2.3",
    "xlsx-js-style": "^1.2.0"
  }
}
