{
  "name": "transrewrt",
  "version": "1.6.4",
  "description": "Translate text between languages, rewrite text in different styles, and transform text using AI.",
  "main": "src/main/main.js",
  "scripts": {
    "dev": "node scripts/electron-rebuild.js && node scripts/write-build-timestamp.js && cross-env NEXT_TELEMETRY_DISABLED=1 ASTRO_TELEMETRY_DISABLED=1 concurrently \"pnpm run watch\" \"pnpm run electron\"",
    "dev:web": "node scripts/node-rebuild.js && node scripts/write-build-timestamp.js && concurrently \"pnpm run watch:web\" \"cross-env NEXT_TELEMETRY_DISABLED=1 ASTRO_TELEMETRY_DISABLED=1 DEV_WEB=true PORT=4030 pnpm run start:server\"",
    "watch": "webpack serve --mode development --port 4030",
    "watch:web": "webpack serve --mode development --port 5500",
    "electron": "wait-on http://localhost:4030 && node scripts/ensure-dev-desktop.js && cross-env NEXT_TELEMETRY_DISABLED=1 ASTRO_TELEMETRY_DISABLED=1 NODE_ENV=development electron . ",
    "build": "cross-env NEXT_TELEMETRY_DISABLED=1 ASTRO_TELEMETRY_DISABLED=1 NODE_ENV=production node node_modules/webpack/bin/webpack.js --mode production",
    "build-renderer": "cross-env NEXT_TELEMETRY_DISABLED=1 ASTRO_TELEMETRY_DISABLED=1 NODE_ENV=production node node_modules/webpack/bin/webpack.js --mode production",
    "start": "cross-env NEXT_TELEMETRY_DISABLED=1 ASTRO_TELEMETRY_DISABLED=1 electron .",
    "start-x11": "cross-env NEXT_TELEMETRY_DISABLED=1 ASTRO_TELEMETRY_DISABLED=1 electron . --disable-gpu-compositing --enable-unsafe-webgpu --ozone-platform=x11",
    "start:server": "cross-env NEXT_TELEMETRY_DISABLED=1 ASTRO_TELEMETRY_DISABLED=1 node scripts/check-node-version.js",
    "start:server:rebuild": "pnpm run postinstall && pnpm run start:server",
    "serve": "pnpm run build-renderer && pnpm run start:server",
    "test": "node --test src/shared/llm/*.test.js dev/presets-check/*.test.js",
    "pricing:update": "node scripts/update-models-dev-pricing.mjs",
    "lint": "eslint . && pnpm run typecheck",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:clean": "node scripts/clean-docker.mjs",
    "docker:devel": "docker build . -t wsj-br/transrewrt:devel",
    "docker:logs": "docker logs transrewrt",
    "docker:shell": "docker exec -it transrewrt /bin/sh",
    "build:main": "cross-env NEXT_TELEMETRY_DISABLED=1 ASTRO_TELEMETRY_DISABLED=1 node node_modules/webpack/bin/webpack.js --config webpack.main.config.js",
    "package": "pnpm run build && pnpm run build:main && node scripts/write-build-timestamp.js && node scripts/electron-rebuild.js && electron-builder",
    "package-arm64": "pnpm run build && pnpm run build:main && node scripts/write-build-timestamp.js && node scripts/electron-rebuild.js && pnpm exec electron-builder --linux AppImage --arm64 --publish never --config build/electron-builder.linux-arm64.cjs",
    "package-mac": "pnpm run build && pnpm run build:main && node scripts/write-build-timestamp.js && node scripts/electron-rebuild.js && pnpm exec electron-builder --mac dmg --publish never",
    "generate-test-data": "node scripts/generate-test-data.js",
    "i18n:sync": "ai-i18n-tools sync",
    "i18n:status": "ai-i18n-tools status",
    "update-version": "node scripts/update-version.js",
    "presets-editor": "node dev/presets-editor/server.js",
    "presets-check": "cd dev/presets-check && node check.js --local",
    "presets-check:install": "node dev/presets-check/install.js",
    "postinstall": "node scripts/electron-rebuild.js",
    "prepackage": "pnpm install --frozen-lockfile",
    "reset-web-password": "node scripts/reset-web-password.js",
    "take-screenshots": "node scripts/take-screenshots.js",
    "generate-banner": "node scripts/generate-transrewrt-banner.js",
    "check-api-key": "node scripts/check-api-key.js",
    "check-custom-provider": "node scripts/check-custom-provider.js",
    "check-provider-icons": "node scripts/check-provider-icons.js",
    "3p-notices": "node scripts/write-third-party-notices.mjs",
    "release:github": "node scripts/release.mjs",
    "release:github:dry": "node scripts/release.mjs --dry-run",
    "website:dev": "cross-env NEXT_TELEMETRY_DISABLED=1 ASTRO_TELEMETRY_DISABLED=1 pnpm --dir website dev",
    "website:build": "cross-env NEXT_TELEMETRY_DISABLED=1 ASTRO_TELEMETRY_DISABLED=1 pnpm --dir website build",
    "website:preview": "cross-env NEXT_TELEMETRY_DISABLED=1 ASTRO_TELEMETRY_DISABLED=1 pnpm --dir website preview",
    "website:publish": "node website/scripts/publish-pages.mjs",
    "website:publish:dry": "node website/scripts/publish-pages.mjs --dry-run",
    "website:i18n:sync": "pnpm --dir website i18n:sync",
    "website:i18n:status": "pnpm --dir website i18n:status",
    "website:i18n:translate": "pnpm --dir website i18n:translate",
    "website:i18n:translate:ui": "pnpm --dir website i18n:translate:ui",
    "website:i18n:locales": "pnpm --dir website i18n:locales"
  },
  "keywords": [
    "electron",
    "react",
    "translator",
    "rewriter",
    "ai-powered",
    "ai-translation",
    "ai-rewriting",
    "ai-transformation"
  ],
  "author": "Waldemar Scudeller Jr.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@12.11.2",
  "build": {
    "appId": "br.com.wsj.transrewrt",
    "productName": "Transrewrt",
    "extraMetadata": {
      "main": "dist-main/main.js"
    },
    "files": [
      "dist/**/*",
      "dist-main/**/*",
      "images/**/*",
      "package.json",
      "build_timestamp",
      "!.git/**",
      "!**/tests/**",
      "!**/test/**",
      "!**/docs/**"
    ],
    "asar": {
      "smartUnpack": true
    },
    "extraFiles": [
      {
        "from": "src/config-defaults/config_default.json",
        "to": "config/config_default.json"
      },
      {
        "from": "easy-mode-config/presets.json",
        "to": "config/presets.json"
      },
      {
        "from": "NOTICES",
        "to": "NOTICES"
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "images"
    },
    "publish": null,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "forceCodeSigning": false,
      "icon": "transrewrt_logo.ico",
      "artifactName": "${productName} Setup ${version}.${ext}"
    },
    "linux": {
      "icon": "transrewrt_logo_512x512.png",
      "desktop": {
        "entry": {
          "StartupWMClass": "transrewrt"
        }
      },
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "transrewrt_logo_512x512.png",
      "identity": null,
      "hardenedRuntime": false,
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "dmg"
        }
      ]
    },
    "dmg": {
      "title": "${productName} ${version}",
      "icon": "transrewrt_logo_512x512.png"
    },
    "nsis": {
      "include": "build/installer.nsh",
      "oneClick": false,
      "installerSidebar": "installerSidebar.bmp",
      "uninstallerSidebar": "installerSidebar.bmp",
      "installerIcon": "transrewrt_logo.ico",
      "uninstallerIcon": "transrewrt_logo.ico",
      "installerHeaderIcon": "transrewrt_logo.ico",
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "Transrewrt"
    }
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.7",
    "@electron/rebuild": "^4.2.1",
    "@eslint/js": "^10.0.1",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.6.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/papaparse": "^5.5.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "babel-loader": "^10.1.1",
    "chalk": "^6.0.1",
    "commander": "^15.0.0",
    "concurrently": "^10.0.6",
    "copy-webpack-plugin": "^14.0.0",
    "cross-env": "^10.1.0",
    "css-loader": "^7.1.5",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-reload": "2.0.0-alpha.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "events": "^3.3.0",
    "glob": "^13.0.6",
    "globals": "^17.13.0",
    "gray-matter": "^4.0.3",
    "html-minifier-terser": "^7.2.0",
    "html-webpack-plugin": "^5.6.8",
    "hyparquet": "^1.31.3",
    "mini-css-extract-plugin": "^2.10.2",
    "papaparse": "^5.7.0",
    "postcss-loader": "^8.2.1",
    "prop-types": "^15.8.1",
    "puppeteer": "^25.13.0",
    "react-refresh": "^0.19.0",
    "semver": "^7.8.5",
    "sharp": "^0.35.5",
    "sql.js": "^1.14.2",
    "style-loader": "^4.0.0",
    "tailwindcss": "^4.3.3",
    "terser": "^5.51.2",
    "terser-webpack-plugin": "5.6.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.1",
    "wait-on": "^9.5.1",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.0.0"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.67",
    "@ctrl/tinycolor": "^4.2.1",
    "@radix-ui/react-alert-dialog": "^1.1.24",
    "@radix-ui/react-checkbox": "^1.3.12",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@radix-ui/react-label": "^2.1.16",
    "@radix-ui/react-popover": "^1.2.0",
    "@radix-ui/react-progress": "^1.1.17",
    "@radix-ui/react-scroll-area": "^1.3.0",
    "@radix-ui/react-select": "^2.3.8",
    "@radix-ui/react-separator": "^1.1.16",
    "@radix-ui/react-slot": "^1.4.0",
    "@radix-ui/react-switch": "^1.3.8",
    "@radix-ui/react-tabs": "^1.1.22",
    "@radix-ui/react-toast": "^1.2.24",
    "@radix-ui/react-toggle": "^1.1.19",
    "@radix-ui/react-toggle-group": "^1.1.20",
    "@radix-ui/react-tooltip": "^1.3.0",
    "adm-zip": "^0.6.1",
    "ai": "^7.0.135",
    "ai-i18n-tools": "^1.10.0",
    "archiver": "^8.0.0",
    "argon2": "^0.45.1",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "diff": "^9.0.0",
    "express": "^5.2.1",
    "i18next": "^26.4.2",
    "lucide-react": "^1.53.0",
    "multer": "^2.4.0",
    "proper-lockfile": "^4.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.16",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "vaul": "^1.1.2",
    "xlsx-js-style": "^1.2.0"
  }
}
