{
  "name": "transrewrt",
  "version": "1.0.1.32",
  "description": "Transrewrt Application",
  "main": "src/main/main.js",
  "scripts": {
    "dev": "./scripts/bump-version.sh && concurrently \"pnpm run watch\" \"pnpm run electron\"",
    "dev:web": "./scripts/bump-version.sh && concurrently \"pnpm run watch:web\" \"cross-env DEV_WEB=true PORT=3030 pnpm run start:server\"",
    "watch": "webpack serve --mode development --port 3030",
    "watch:web": "webpack serve --mode development --port 5000",
    "electron": "wait-on http://localhost:3030 && cross-env NODE_ENV=development electron . --disable-gpu-compositing --enable-unsafe-webgpu --ozone-platform=x11",
    "build": "node node_modules/webpack/bin/webpack.js --mode production",
    "build-renderer": "node node_modules/webpack/bin/webpack.js --mode production",
    "start": "electron .",
    "start-x11": "electron . --disable-gpu-compositing --enable-unsafe-webgpu --ozone-platform=x11",
    "start:server": "node server/index.js",
    "serve": "pnpm run build-renderer && pnpm run start:server",
    "test": "echo \"Error: no test specified\" && exit 1",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:clean": "./scripts/clean-docker.sh",
    "docker:devel": "docker build . -t wsj-br/transrewrt:devel",
    "docker:deploy": "./scripts/docker-deploy.sh",
    "package": "./scripts/bump-version.sh && electron-builder"
  },
  "keywords": [
    "electron",
    "react",
    "translator",
    "rewriter"
  ],
  "author": "Waldemar Scudeller Jr.",
  "license": "MIT",
  "build": {
    "appId": "br.com.wsj.transrewrt",
    "productName": "Transrewrt",
    "files": [
      "dist/**/*",
      "src/main/main.js",
      "package.json"
    ],
    "extraFiles": [
      {
        "from": "config_default.json",
        "to": "config_default.json"
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "."
    },
    "win": {
      "target": "nsis",
      "forceCodeSigning": false,
      "icon": "transrewrt_logo.ico",
      "artifactName": "${productName} Setup ${version}.${ext}"
    },
    "nsis": {
      "installerIcon": "transrewrt_logo.ico",
      "uninstallerIcon": "transrewrt_logo.ico",
      "installerHeaderIcon": "transrewrt_logo.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Transrewrt"
    }
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-react": "^7.28.5",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.6.2",
    "babel-loader": "^10.0.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "css-loader": "^7.1.4",
    "electron": "^40.4.1",
    "electron-builder": "^26.7.0",
    "electron-reload": "^2.0.0-alpha.1",
    "html-webpack-plugin": "^5.6.6",
    "mini-css-extract-plugin": "^2.10.0",
    "react-refresh": "^0.18.0",
    "style-loader": "^4.0.0",
    "wait-on": "^9.0.4",
    "webpack": "^5.105.2",
    "webpack-cli": "^6.0.1"
  },
  "pnpm": {
    "overrides": {
      "lodash-es": "^4.17.23",
      "rimraf": "^5.0.0",
      "glob": "^13.0.0",
      "global-agent": "^4.1.2",
      "qs": ">=6.14.2"
    },
    "onlyBuiltDependencies": [
      "core-js-pure",
      "electron",
      "electron-winstaller",
      "better-sqlite3",
      "argon2"
    ]
  },
  "dependencies": {
    "argon2": "^0.41.1",
    "better-sqlite3": "^11.6.0",
    "proper-lockfile": "^4.1.2",
    "@ctrl/tinycolor": "^4.2.0",
    "@fluentui/react-components": "^9.73.0",
    "@fluentui/react-icons": "^2.0.319",
    "electron-squirrel-startup": "^1.0.1",
    "express": "^5.2.1",
    "lucide-react": "^0.574.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "webpack-dev-server": "^5.2.3"
  }
}
