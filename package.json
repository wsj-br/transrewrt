{
  "name": "transrewrt",
  "version": "1.6.1",
  "description": "Translate text between languages, rewrite text in different styles, and transform text using AI.",
  "main": "src/main/main.js",
  "scripts": {
    "dev": "node scripts/electron-rebuild.js && node scripts/write-build-timestamp.js && concurrently \"pnpm run watch\" \"pnpm run electron\"",
    "dev:web": "node scripts/node-rebuild.js && node scripts/write-build-timestamp.js && concurrently \"pnpm run watch:web\" \"cross-env DEV_WEB=true PORT=4030 pnpm run start:server\"",
    "watch": "webpack serve --mode development --port 4030",
    "watch:web": "webpack serve --mode development --port 5500",
    "electron": "wait-on http://localhost:4030 && node scripts/ensure-dev-desktop.js && cross-env NODE_ENV=development electron . ",
    "build": "cross-env NODE_ENV=production node node_modules/webpack/bin/webpack.js --mode production",
    "build-renderer": "cross-env NODE_ENV=production node node_modules/webpack/bin/webpack.js --mode production",
    "start": "electron .",
    "start-x11": "electron . --disable-gpu-compositing --enable-unsafe-webgpu --ozone-platform=x11",
    "start:server": "node scripts/check-node-version.js",
    "start:server:rebuild": "pnpm run postinstall && pnpm run start:server",
    "serve": "pnpm run build-renderer && pnpm run start:server",
    "test": "node --test src/shared/llm/stripPromptWrapperTags.test.js",
    "lint": "eslint . && pnpm run typecheck",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:clean": "./scripts/clean-docker.sh",
    "docker:devel": "docker build . -t wsj-br/transrewrt:devel",
    "docker:logs": "docker logs transrewrt",
    "docker:shell": "docker exec -it transrewrt /bin/sh",
    "build:main": "node node_modules/webpack/bin/webpack.js --config webpack.main.config.js",
    "package": "pnpm run build && pnpm run build:main && node scripts/write-build-timestamp.js && node scripts/electron-rebuild.js && electron-builder",
    "package-arm64": "pnpm run build && pnpm run build:main && node scripts/write-build-timestamp.js && node scripts/electron-rebuild.js && pnpm exec electron-builder --linux AppImage --arm64 --publish never --config build/electron-builder.linux-arm64.cjs",
    "generate-test-data": "node scripts/generate-test-data.js",
    "i18n:extract": "ai-i18n-tools extract",
    "i18n:sync": "ai-i18n-tools sync",
    "i18n:translate": "ai-i18n-tools translate-ui && ai-i18n-tools translate-docs",
    "i18n:translate:ui": "ai-i18n-tools translate-ui",
    "i18n:translate:svg": "echo \"SVG translation is not configured. To enable it: set features.translateSVG and add a svg block in ai-i18n-tools.config.json.\"",
    "i18n:translate:docs": "ai-i18n-tools translate-docs",
    "i18n:status": "ai-i18n-tools status",
    "i18n:dashboard": "ai-i18n-tools dashboard",
    "i18n:editor": "ai-i18n-tools dashboard",
    "i18n:locales": "ai-i18n-tools generate-ui-languages",
    "i18n:cleanup": "ai-i18n-tools cleanup",
    "clean-temp": "ai-i18n-tools clean-temp",
    "update-version": "node scripts/update-version.js",
    "presets-editor": "node dev/presets-editor/server.js",
    "presets-check": "cd dev/presets-check && node check.js --local",
    "presets-check:install": "node dev/presets-check/install.js",
    "postinstall": "node scripts/electron-rebuild.js",
    "prepackage": "pnpm install --no-frozen-lockfile",
    "reset-web-password": "node scripts/reset-web-password.js",
    "take-screenshots": "node scripts/take-screenshots.js",
    "generate-banner": "node scripts/generate-transrewrt-banner.js",
    "check-api-key": "node scripts/check-api-key.js",
    "check-custom-provider": "node scripts/check-custom-provider.js",
    "3p-notices": "node scripts/write-third-party-notices.mjs",
    "notices:write": "node scripts/write-third-party-notices.mjs",
    "release:github": "bash scripts/release.sh",
    "release:github:dry": "bash scripts/release.sh --dry-run",
    "release:github:win": "pwsh -NoProfile -File scripts/release.ps1",
    "release:github:dry:win": "pwsh -NoProfile -File scripts/release.ps1 -DryRun",
    "website:dev": "pnpm --dir website dev",
    "website:build": "pnpm --dir website build",
    "website:preview": "pnpm --dir website preview",
    "website:i18n:extract": "pnpm --dir website i18n:extract",
    "website:i18n:status": "pnpm --dir website i18n:status",
    "website:i18n:translate": "pnpm --dir website i18n:translate",
    "website:i18n:translate:ui": "pnpm --dir website i18n:translate:ui",
    "website:i18n:locales": "pnpm --dir website i18n:locales"
  },
  "keywords": [
    "electron",
    "react",
    "translator",
    "rewriter",
    "ai-powered",
    "ai-translation",
    "ai-rewriting",
    "ai-transformation"
  ],
  "author": "Waldemar Scudeller Jr.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.13.1",
  "build": {
    "appId": "br.com.wsj.transrewrt",
    "productName": "Transrewrt",
    "extraMetadata": {
      "main": "dist-main/main.js"
    },
    "files": [
      "dist/**/*",
      "dist-main/**/*",
      "images/**/*",
      "package.json",
      "build_timestamp",
      "!.git/**",
      "!**/tests/**",
      "!**/test/**",
      "!**/docs/**"
    ],
    "asar": {
      "smartUnpack": true
    },
    "extraFiles": [
      {
        "from": "src/config-defaults/config_default.json",
        "to": "config/config_default.json"
      },
      {
        "from": "easy-mode-config/presets.json",
        "to": "config/presets.json"
      },
      {
        "from": "NOTICES",
        "to": "NOTICES"
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "images"
    },
    "publish": null,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "forceCodeSigning": false,
      "icon": "transrewrt_logo.ico",
      "artifactName": "${productName} Setup ${version}.${ext}"
    },
    "linux": {
      "icon": "transrewrt_logo_512x512.png",
      "desktop": {
        "entry": {
          "StartupWMClass": "transrewrt"
        }
      },
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "include": "build/installer.nsh",
      "oneClick": false,
      "installerSidebar": "installerSidebar.bmp",
      "uninstallerSidebar": "installerSidebar.bmp",
      "installerIcon": "transrewrt_logo.ico",
      "uninstallerIcon": "transrewrt_logo.ico",
      "installerHeaderIcon": "transrewrt_logo.ico",
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "Transrewrt"
    }
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.1",
    "@electron/rebuild": "^4.2.0",
    "@eslint/js": "^9.39.5",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.6.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/papaparse": "^5.5.2",
    "babel-loader": "^10.1.1",
    "chalk": "^5.6.2",
    "commander": "^15.0.0",
    "concurrently": "^10.0.3",
    "copy-webpack-plugin": "^14.0.0",
    "cross-env": "^10.1.0",
    "css-loader": "^7.1.4",
    "electron": "^42.7.0",
    "electron-builder": "^26.15.3",
    "electron-reload": "2.0.0-alpha.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "events": "^3.3.0",
    "glob": "^13.0.6",
    "globals": "^17.7.0",
    "gray-matter": "^4.0.3",
    "html-webpack-plugin": "^5.6.7",
    "mini-css-extract-plugin": "^2.10.2",
    "papaparse": "^5.5.4",
    "postcss-loader": "^8.2.1",
    "prop-types": "^15.8.1",
    "puppeteer": "^25.3.0",
    "react-refresh": "^0.18.0",
    "semver": "^7.8.5",
    "sharp": "^0.35.3",
    "sql.js": "^1.14.1",
    "style-loader": "^4.0.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "wait-on": "^9.0.10",
    "webpack": "^5.108.4",
    "webpack-cli": "^7.2.1"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.11",
    "@ctrl/tinycolor": "^4.2.0",
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-checkbox": "^1.3.7",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-label": "^2.1.11",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-progress": "^1.1.12",
    "@radix-ui/react-scroll-area": "^1.2.14",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-separator": "^1.1.11",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-switch": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.17",
    "@radix-ui/react-toast": "^1.2.19",
    "@radix-ui/react-toggle": "^1.1.14",
    "@radix-ui/react-toggle-group": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.12",
    "adm-zip": "^0.6.0",
    "ai": "^7.0.29",
    "ai-i18n-tools": "^1.8.2",
    "archiver": "^8.0.0",
    "argon2": "^0.44.0",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "diff": "^9.0.0",
    "express": "^5.2.1",
    "i18next": "^26.3.6",
    "lucide-react": "^1.24.0",
    "multer": "^2.2.0",
    "proper-lockfile": "^4.1.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.10",
    "recharts": "^3.9.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "vaul": "^1.1.2",
    "webpack-dev-server": "^6.0.0",
    "xlsx-js-style": "^1.2.0"
  }
}
