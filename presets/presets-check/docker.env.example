# Environment file for the Transrewrt presets-check Docker container.
#
# Standalone server (no repository clone needed):
#   curl -fsSL https://raw.githubusercontent.com/wsj-br/transrewrt/main/presets/presets-check/docker.env.example -o presets-check.env
# Local repository checkout:
#   cp presets/presets-check/docker.env.example presets-check.env
#
# Both REQUIRED variables must be non-empty before starting the container,
# otherwise the container prints an error and exits immediately.
# Full setup guide: https://github.com/wsj-br/transrewrt/blob/main/presets/presets-check/README.md

# REQUIRED — Fine-grained GitHub PAT for wsj-br/transrewrt (Contents: Read and write).
# Create at https://github.com/settings/personal-access-tokens
# Passed on demand via GIT_ASKPASS; never stored in .git/config.
GITHUB_TOKEN=

# REQUIRED — ntfy topic for run summaries and failure alerts (use a long, unguessable name).
PRESET_CHECK_NTFY_TOPIC=

# Optional — ntfy server URL and bearer token (only needed for protected/self-hosted topics).
PRESET_CHECK_NTFY_SERVER=https://ntfy.sh
PRESET_CHECK_NTFY_TOKEN=

# Optional — Cron schedule (5 fields or @daily, @hourly, etc.) in container timezone (TZ).
PRESET_CHECK_CRON=0 6 * * *
TZ=Europe/London

# Optional — Git commit author for automated easy-mode-config/presets.json commits.
PRESET_CHECK_GIT_NAME=presets-check
PRESET_CHECK_GIT_EMAIL=presets-check@users.noreply.github.com

# Optional — Easy-mode cloud provider API keys.
# OpenRouter's model list is public (checked even without a key); setting OPENROUTER_API_KEY
# enables live smoke-testing before replacing an OpenRouter model.
# All other providers below require an API key both to fetch their model catalog and to
# smoke-test replacements. Any provider left blank is skipped (not treated as an error).
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=
CEREBRAS_API_KEY=
